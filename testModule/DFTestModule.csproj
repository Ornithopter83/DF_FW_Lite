<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>DFTestModule</RootNamespace>
    <AssemblyName>DFTestModuleLite</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <EmbeddedResource Include="esptool_V4.5.1.exe" LogicalName="DFTestModule.esptool_V4.5.1.exe" />
    <EmbeddedResource Include="Assets\reel-top-v2.png" Condition="Exists('Assets\reel-top-v2.png')" LogicalName="DFTestModule.Assets.reel-top-v2.png" />
    <EmbeddedResource Include="Assets\reel-bottom.png" Condition="Exists('Assets\reel-bottom.png')" LogicalName="DFTestModule.Assets.reel-bottom.png" />
  </ItemGroup>
  <Target Name="RestoreEmbeddedEsptool" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\restore-tm-updater.ps1&quot;" />
  </Target>
</Project>
